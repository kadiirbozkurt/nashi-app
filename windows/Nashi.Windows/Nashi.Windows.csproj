<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Brand/app.ico</ApplicationIcon><UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <AssemblyName>Nashi</AssemblyName><Product>Bozkurt Çark</Product><AssemblyTitle>Bozkurt Çark</AssemblyTitle><Company>Bozkurt</Company><Product>Bozkurt Çark</Product><AssemblyTitle>Bozkurt Çark</AssemblyTitle><Company>Bozkurt</Company><Product>Bozkurt Çark</Product><AssemblyTitle>Bozkurt Çark</AssemblyTitle><Company>Bozkurt</Company><Product>Bozkurt Çark</Product><AssemblyTitle>Bozkurt Çark</AssemblyTitle><Company>Bozkurt</Company><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PublishSingleFile>false</PublishSingleFile><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Nashi.Core/Nashi.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <!-- Bozkurt Çark brand (Brand/, rendered by tools/BrandGen) under the asset names the code already uses. -->
    <Resource Include="Brand/icon.png" Link="Assets/NashiIcon.png" />
    <Resource Include="Brand/mark.png" Link="Assets/NashiMark.png" />
    <Resource Include="Brand/mark-active.png" Link="Assets/NashiMarkHappy.png" />
    <Resource Include="Brand/logo.png" Link="Assets/logo.png" />
    <Resource Include="Brand/night.jpg" Link="Assets/night.jpg" />
    <Resource Include="../../Resources/Sounds/WheelSelection.wav" Link="Assets/WheelSelection.wav" />
    <Content Include="../../Resources/PagesInterop.js" Link="PagesInterop.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../scripts/pages-windows.js" Link="pages-windows.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Resources/licenses/cupertino-files/**" Link="licenses/cupertino-files/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../licenses/**" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" Version="155.0.8044" />
  </ItemGroup>
</Project>
